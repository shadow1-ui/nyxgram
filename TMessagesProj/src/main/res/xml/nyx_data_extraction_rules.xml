<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
<cloud-backup disableIfNoEncryptionCapabilities="true">
    <exclude domain="database" path="nyx_archive.db"/>
    <exclude domain="database" path="nyx_archive.db-journal"/>
    <exclude domain="database" path="nyx_archive.db-wal"/>
    <exclude domain="database" path="nyx_archive.db-shm"/>
    <exclude domain="sharedpref" path="nyx_security.xml"/>
    <exclude domain="sharedpref" path="nyxgram.xml"/>
    <exclude domain="file" path="nyx_updates/"/>
</cloud-backup>
<device-transfer>
    <exclude domain="database" path="nyx_archive.db"/>
    <exclude domain="database" path="nyx_archive.db-journal"/>
    <exclude domain="database" path="nyx_archive.db-wal"/>
    <exclude domain="database" path="nyx_archive.db-shm"/>
    <exclude domain="sharedpref" path="nyx_security.xml"/>
    <exclude domain="sharedpref" path="nyxgram.xml"/>
    <exclude domain="file" path="nyx_updates/"/>
</device-transfer>
</data-extraction-rules>
